# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Caches and test outputs
.pytest_cache/
*.log

# Virtual environments
venv/
.env/
.venv/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# Solidity build artifacts (if you use truffle, hardhat, or foundry in the future)
build/
artifacts/
cache/

# Node modules (if you use JS tooling in the future)
node_modules/

# Ignore secrets/configs (if any)
*.env
.env.*

# Ignore coverage reports
htmlcov/
.coverage
coverage.xml

# Ignore test contract outputs (if any)
test_contracts/*.bin
test_contracts/*.abi

# Ignore main config if you want (uncomment if needed)
# analyzer_config.yaml
# Solc native binaries (re-downloadable via the dispatcher / binaries.soliditylang.org)
solc_versions/solc-*

# Foundry build output
out/
opencode_artifacts/exploit_pocs/out/

# Large per-dir Slither result JSONs (1.3-1.6GB per run) - keep only TSV/logs
tools/slither_out/
opencode_artifacts/slither_*/results/
